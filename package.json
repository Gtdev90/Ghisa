{
  "name": "ghisa",
  "version": "1.0.0",
  "private": true,
  "description": "GHISA - PWA per l'allenamento in palestra (test massimali + fase 1)",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "icons": "node scripts/icons.mjs",
    "precache": "node scripts/precache.mjs",
    "build": "node scripts/vendor.mjs && node scripts/precache.mjs",
    "serve": "node scripts/serve.mjs",
    "android:res": "node scripts/android-res.mjs",
    "android:sync": "node scripts/precache.mjs && npx cap sync android",
    "android:open": "npx cap open android",
    "apk": "node scripts/apk.mjs",
    "pubblica": "node scripts/pubblica.mjs"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@fontsource-variable/big-shoulders-display": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@fontsource/barlow": "5.3.0",
    "gsap": "3.15.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3"
  }
}
